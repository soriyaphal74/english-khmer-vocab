---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English. The word cards come from src/words.ts.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { topics } from '../words';

const wordCount = topics.reduce((n, t) => n + t.words.length, 0);

const steps = [
  {
    icon: '📚',
    title: 'Pick a topic',
    titleKm: 'ជ្រើសរើសប្រធានបទ',
    text: 'Start with words you use every day, like food, family, or numbers.',
    textKm: 'ចាប់ផ្តើមជាមួយពាក្យដែលអ្នកប្រើរាល់ថ្ងៃ ដូចជា អាហារ គ្រួសារ ឬលេខ។',
  },
  {
    icon: '🤔',
    title: 'Guess the meaning',
    titleKm: 'ទាយអត្ថន័យ',
    text: 'Read the English word. Say the Khmer meaning in your head.',
    textKm: 'អានពាក្យអង់គ្លេស។ និយាយអត្ថន័យជាភាសាខ្មែរនៅក្នុងចិត្ត។',
  },
  {
    icon: '👆',
    title: 'Tap to check',
    titleKm: 'ចុចដើម្បីពិនិត្យ',
    text: 'Tap the card to see the answer. Tap 🔊 to hear the English word.',
    textKm: 'ចុចលើកាត ដើម្បីមើលចម្លើយ។ ចុច 🔊 ដើម្បីស្តាប់ពាក្យអង់គ្លេស។',
  },
];
---

<Base>
  <Header />
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 sm:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-sun/25 px-3 py-1 text-sm font-semibold">
            ✨ {wordCount} words · {topics.length} topics · free
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
            Learn English words, <span class="text-brand">one card at a time.</span>
            <span class="km" lang="km">រៀនពាក្យអង់គ្លេស ម្តងមួយកាត។</span>
          </h1>
          <p class="mt-5 max-w-xl text-lg text-muted">
            Simple word cards with Khmer meanings. Guess, tap, and check. Works on any phone.
            <span class="km" lang="km">កាតពាក្យសាមញ្ញ ជាមួយអត្ថន័យជាភាសាខ្មែរ។ ទាយ ចុច ហើយពិនិត្យ។ ប្រើបានលើទូរសព្ទគ្រប់ប្រភេទ។</span>
          </p>
          <a href="#words" class="mt-8 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-paper hover:bg-brand-dark">
            Start learning ↓ <span lang="km" class="font-khmer font-normal">ចាប់ផ្តើមរៀន</span>
          </a>
        </div>

        <!-- A sample card, so visitors see how it works -->
        <div class="mx-auto w-full max-w-sm">
          <div class="rotate-2 rounded-3xl bg-white p-8 text-center shadow-xl ring-1 ring-ink/5">
            <p class="text-sm font-semibold uppercase tracking-wider text-muted">English</p>
            <p class="mt-2 font-display text-5xl font-extrabold">thank you</p>
            <div class="my-6 border-t border-dashed border-ink/15"></div>
            <p class="text-sm font-semibold uppercase tracking-wider text-muted">Khmer <span lang="km">ខ្មែរ</span></p>
            <p class="mt-2 text-4xl font-bold text-brand" lang="km">អរគុណ</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="scroll-mt-20 bg-white/60 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          How it works
          <span class="km" lang="km">របៀបប្រើ</span>
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <div class="rounded-2xl bg-paper p-6 ring-1 ring-ink/5">
                <p class="text-3xl">{s.icon}</p>
                <h3 class="mt-3 font-display text-xl font-bold">
                  {i + 1}. {s.title}
                  <span class="km" lang="km">{s.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {s.text}
                  <span class="km" lang="km">{s.textKm}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Word cards, one group per topic -->
    <section id="words" class="scroll-mt-20 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Words
          <span class="km" lang="km">ពាក្យ</span>
        </h2>

        <!-- Topic shortcuts -->
        <nav class="mt-6 flex flex-wrap gap-2">
          {
            topics.map((t) => (
              <a href={`#${t.id}`} class="rounded-full bg-white px-4 py-2 text-sm font-semibold ring-1 ring-ink/10 hover:bg-brand hover:text-paper">
                {t.icon} {t.title}
              </a>
            ))
          }
        </nav>

        {
          topics.map((t) => (
            <div id={t.id} class="mt-12 scroll-mt-20">
              <h3 class="font-display text-2xl font-bold">
                {t.icon} {t.title}
                <span class="km" lang="km">{t.titleKm}</span>
              </h3>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                {t.words.map((w) => (
                  <div class="relative rounded-2xl bg-white ring-1 ring-ink/10 has-[details[open]]:ring-2 has-[details[open]]:ring-brand">
                    <details class="group">
                      <summary class="flex min-h-32 cursor-pointer list-none flex-col items-center justify-center p-4 text-center [&::-webkit-details-marker]:hidden">
                        <span class="font-display text-xl font-bold">{w.en}</span>
                        <span class="mt-2 text-xs text-muted group-open:hidden">Tap to see Khmer</span>
                        <span class="mt-2 hidden text-2xl font-bold text-brand group-open:block" lang="km">{w.km}</span>
                      </summary>
                    </details>
                    <button
                      type="button"
                      data-say={w.en}
                      aria-label={`Listen: ${w.en}`}
                      class="say absolute top-1 right-1 hidden size-8 items-center justify-center rounded-full text-sm hover:bg-ink/5"
                    >
                      🔊
                    </button>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- About -->
    <section class="bg-ink py-16 text-paper">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Why I made this
          <span class="km" lang="km">ហេតុអ្វីខ្ញុំបង្កើតវា</span>
        </h2>
        <p class="mt-5 text-lg text-paper/80">
          Learning English is easier with small steps. I wanted a free place where Khmer speakers can learn a few new words every day, on their phone.
          <span class="km" lang="km">ការរៀនភាសាអង់គ្លេសងាយស្រួលជាងនៅពេលធ្វើម្តងបន្តិចៗ។ ខ្ញុំចង់បានកន្លែងឥតគិតថ្លៃមួយ ដែលអ្នកនិយាយភាសាខ្មែរអាចរៀនពាក្យថ្មីពីរបីរាល់ថ្ងៃ នៅលើទូរសព្ទរបស់ពួកគេ។</span>
        </p>
        <a href={`mailto:${site.contactEmail}`} class="mt-8 inline-block rounded-full bg-sun px-6 py-3 font-semibold text-ink hover:bg-paper">
          Suggest a word <span lang="km" class="font-khmer font-normal">ណែនាំពាក្យមួយ</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // The 🔊 buttons read the English word out loud, using the phone or
  // computer's built-in voice. They stay hidden if the browser can't speak.
  if ('speechSynthesis' in window) {
    document.querySelectorAll<HTMLButtonElement>('button.say').forEach((btn) => {
      btn.classList.remove('hidden');
      btn.classList.add('flex');
      btn.addEventListener('click', () => {
        const say = new SpeechSynthesisUtterance(btn.dataset.say);
        say.lang = 'en-US';
        say.rate = 0.85;
        speechSynthesis.cancel();
        speechSynthesis.speak(say);
      });
    });
  }
</script>
